# PostgreSQL (Neon или любой другой провайдер). DIRECT_DATABASE_URL — прямое
# подключение без пулера, нужно отдельно для миграций (Prisma рекомендует
# это для Neon — через пулер миграции могут подвисать).
DATABASE_URL="postgresql://user:password@your-pooler-host/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@your-direct-host/dbname?sslmode=require"

# Ключ Claude API для модуля рерайта (lib/rewrite.ts)
ANTHROPIC_API_KEY=""

# Секрет для защиты /api/cron от внешнего вызова кем попало
CRON_SECRET="change-me"

# Админка — простой логин/пароль, без ролей (см. ТЗ)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="change-me-too"
